generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Booking {
  id            String   @id @default(uuid())
  name          String
  bmsNumber     String?
  staffNumber   String
  phoneNumber   String?
  role          String?  @default("Agent")
  location      String?
  route         String?
  shift         String
  date          DateTime
  address       String?
  process       String?
  pinLocation   String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?
  createdAt     DateTime @default(now())

  @@unique([staffNumber, date, shift])
}

model Staff {
  id             String      @id @default(uuid())
  name           String
  bmsNumber      String?     @unique
  staffNumber    String      @unique
  password       String?     // Staff password (defaults to BMS Number)
  phoneNumber    String?
  role           String      @default("Agent")
  supervisorName String?
  supervisorId   String?
  location       String?
  currentShift   String?
  process       String?
  route         String?
  address       String?
  pinLocation   String?
  latitude      Float?
  longitude     Float?
  googleMapsUrl String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  schedules     Schedule[]
}

model BookingEditRequest {
  id               String   @id @default(uuid())
  bookingId        String
  staffNumber      String
  requestedChanges Json
  status           String   @default("PENDING")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model SystemSettings {
  id              String   @id @default("singleton")
  bookingsOpen    Boolean  @default(true)
  automationRules Json?
  updatedAt       DateTime @updatedAt
}

model ShiftConfig {
  id          String   @id @default(uuid())
  role        String
  name        String
  startTime   String
  endTime     String
  shiftLabel  String
  isOvernight Boolean  @default(false)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Schedule {
  id           String    @id @default(uuid())
  staffNumber  String
  staff        Staff     @relation(fields: [staffNumber], references: [staffNumber], onDelete: Cascade)
  role         String    @default("Agent")
  shift        String
  startDate    DateTime
  endDate      DateTime
  workingDays  Int[]     @default([1, 2, 3, 4, 5]) // 0=Sun, 1=Mon, ..., 6=Sat
  notes        String?
  status       String    @default("ACTIVE")
  lastSyncedAt DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Vehicle {
  id          String   @id @default(uuid())
  plateNumber String   @unique
  model       String
  capacity    Int      // 5 to 14
  driverName  String?
  driverPhone String?
  status      String   @default("AVAILABLE") // AVAILABLE, ON_TRIP, MAINTENANCE
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  trips       Trip[]
}

model Trip {
  id          String          @id @default(uuid())
  tripNumber  String          @unique
  type        String          @default("DROPOFF") // "DROPOFF" or "PICKUP"
  date        DateTime
  shift       String
  route       String
  hubLocation String?
  status      String          @default("SCHEDULED") // "SCHEDULED", "IN_PROGRESS", "COMPLETED"
  vehicleId   String?
  vehicle     Vehicle?        @relation(fields: [vehicleId], references: [id], onDelete: SetNull)
  driverName  String?
  driverPhone String?
  notes       String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  passengers  TripPassenger[]
}

model TripPassenger {
  id           String   @id @default(uuid())
  tripId       String
  trip         Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade)
  bookingId    String?
  staffName    String
  bmsNumber    String
  staffNumber  String?
  phoneNumber  String?
  address      String?
  latitude     Float?
  longitude    Float?
  distanceKm   Float?
  stopSequence Int
  status       String   @default("BOARDED") // BOARDED, DROPPED_OFF, PICKED_UP, NO_SHOW
  createdAt    DateTime @default(now())
}

model CampaignConfig {
  id               String   @id @default(uuid())
  name             String   @unique
  code             String?
  status           String   @default("ACTIVE") // ACTIVE, INACTIVE, PAUSED
  defaultRestDays  Int[]    @default([5, 6]) // 0=Sun, 1=Mon, ..., 6=Sat
  allowedRestDays  Int[]    @default([5, 6, 0, 1]) // For Caption call: Friday, Saturday, Sunday, Monday
  workingDaysCount Int      @default(5)
  restDaysCount    Int      @default(2)
  notes            String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
